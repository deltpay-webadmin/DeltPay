# ──────────────────────────────────────────────────────────────
# Supabase — powers login (Supabase Auth) and the /dashboard CRM.
#
# Copy this file to `.env.local` and fill in the values from
# Supabase → Project Settings → API. Set the same variables in your
# hosting provider (e.g. Vercel → Project → Settings → Environment
# Variables) so production builds get them too.
#
# The anon / publishable key is intended for browser use and is safe
# to expose. Never put the service_role key in a VITE_ variable.
# ──────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ──────────────────────────────────────────────────────────────
# Plaid — Supabase EDGE FUNCTION secrets, NOT Vite/browser vars.
# Do not put these in .env.local; set them via:
#   supabase secrets set KEY=value
# or Supabase → Project Settings → Edge Functions → Secrets.
# Documented here so the full configuration surface is in one place.
# See docs/plaid-production-cutover.md for the sandbox→production runbook.
#
# PLAID_CLIENT_ID=        # Plaid dashboard → Team Settings → Keys
# PLAID_SECRET=           # environment-specific: sandbox vs production secret
# PLAID_ENV=sandbox       # "sandbox" | "production" (unset → sandbox + UI warning;
#                         # any other value blocks all Plaid calls)
# PLAID_PRODUCTS=auth,transactions,identity
# PLAID_OPTIONAL_PRODUCTS=  # e.g. liabilities,investments — ONLY list products
#                           # your Plaid production account is enabled for;
#                           # production rejects link tokens otherwise
# PLAID_REDIRECT_URI=     # optional; required for OAuth banks (Chase etc.).
#                         # Must EXACTLY match a URI registered in Plaid
#                         # dashboard → API → Allowed redirect URIs,
#                         # e.g. https://www.deltpay.com/plaid-oauth-callback
# PLAID_WEBHOOK_VERIFY=   # optional override: enforce | log | off
#                         # (default: enforce in production, log in sandbox)
# APPLY_EXCHANGE_SECRET=  # shared secret gating the public applicant-side
#                         # exchange route (/apply/plaid-exchange) called by
#                         # deltcapital.com. Unset → route disabled (403).
#                         # Same value goes in the deltcapital.com Vercel env.
#                         # See docs/plaid-testing-strategy.md.

# ──────────────────────────────────────────────────────────────
# CRM connect-link emails — Supabase EDGE FUNCTION secrets (same
# mechanism as the Plaid block above). Powers the "Email Link" action
# on a lead: the branded invite, open/click tracking, and the staff
# "bank connected" notice. Unset RESEND_API_KEY → the send route
# errors with "Email is not configured"; clipboard copy still works.
#
# RESEND_API_KEY=         # same Resend key the Vercel api/leads/* routes use
# LEAD_EMAIL_FROM=        # optional; default "Delt Capital <noreply@deltpay.com>"
#                         # (prospect-facing From — matches the Plaid page brand)
# SITE_ORIGIN=            # optional; where email-track /click lands unknown
#                         # tokens (default https://deltpay.com)
