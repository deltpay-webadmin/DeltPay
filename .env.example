# ──────────────────────────────────────────────────────────────
# Supabase — powers login (Supabase Auth) and the /dashboard CRM.
#
# Copy this file to `.env.local` and fill in the values from
# Supabase → Project Settings → API. Set the same variables in your
# hosting provider (e.g. Vercel → Project → Settings → Environment
# Variables) so production builds get them too.
#
# The anon / publishable key is intended for browser use and is safe
# to expose. Never put the service_role key in a VITE_ variable.
# ──────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ──────────────────────────────────────────────────────────────
# Plaid — Supabase EDGE FUNCTION secrets, NOT Vite/browser vars.
# Do not put these in .env.local; set them via:
#   supabase secrets set KEY=value
# or Supabase → Project Settings → Edge Functions → Secrets.
# Documented here so the full configuration surface is in one place.
# See docs/plaid-production-cutover.md for the sandbox→production runbook.
#
# PLAID_CLIENT_ID=        # Plaid dashboard → Team Settings → Keys
# PLAID_SECRET=           # environment-specific: sandbox vs production secret
# PLAID_ENV=sandbox       # "sandbox" | "production" (unset → sandbox + UI warning;
#                         # any other value blocks all Plaid calls)
# PLAID_PRODUCTS=transactions
#                         # default: transactions only. Listing auth/identity
#                         # here bills their one-time fees at link time —
#                         # leave them in PLAID_OPTIONAL_PRODUCTS instead so
#                         # they're billed only when "Verify ownership" runs.
# PLAID_OPTIONAL_PRODUCTS=  # default: auth,identity (deferred billing).
#                           # Add e.g. liabilities,investments — ONLY list
#                           # products your Plaid production account is
#                           # enabled for; production rejects link tokens
#                           # otherwise
# PLAID_IDV_TEMPLATE_ID=  # idvtmp_… from Plaid dashboard → Identity
#                         # Verification → Templates. Enables "Start
#                         # verification" on prospects (billable per
#                         # verification) and IDV retry fallback.
# PLAID_MONITOR_PROGRAM_ID= # Plaid dashboard → Monitor → Programs. Required
#                           # for AML watchlist screening ("Screen now");
#                           # screening calls fail with a setup message
#                           # until this is set.
# PLAID_REDIRECT_URI=     # optional; required for OAuth banks (Chase etc.).
#                         # Must EXACTLY match a URI registered in Plaid
#                         # dashboard → API → Allowed redirect URIs,
#                         # e.g. https://www.deltpay.com/plaid-oauth-callback
# PLAID_WEBHOOK_VERIFY=   # optional override: enforce | log | off
#                         # (default: enforce in production, log in sandbox)
# APPLY_EXCHANGE_SECRET=  # shared secret gating the public applicant-side
#                         # exchange route (/apply/plaid-exchange) called by
#                         # deltcapital.com. Unset → route disabled (403).
#                         # Same value goes in the deltcapital.com Vercel env.
#                         # See docs/plaid-testing-strategy.md.
#
# ──────────────────────────────────────────────────────────────
# MPA boarding — Supabase EDGE FUNCTION secret (mpa-application).
# See docs/mpa-boarding.md for the full setup runbook.
#
# APP_ENCRYPTION_KEY=     # 32 bytes base64 (`openssl rand -base64 32`).
#                         # Encrypts merchant application SSNs/DOBs/bank
#                         # numbers at rest (AES-256-GCM). Back it up —
#                         # losing it orphans every stored application's
#                         # sensitive fields. Unset → those flows fail closed.
#
# ──────────────────────────────────────────────────────────────
# DocuSign e-sign — Supabase EDGE FUNCTION secrets (docusign,
# docusign-connect). The CRM cannot send or countersign without these.
#
# DOCUSIGN_INTEGRATION_KEY=   # App integration key (client id)
# DOCUSIGN_USER_ID=           # API user GUID to impersonate (JWT grant)
# DOCUSIGN_PRIVATE_KEY=       # RSA private key PEM for the integration key
# DOCUSIGN_ENV=               # 'demo' (default) or 'production'
# DOCUSIGN_ACCOUNT_ID=        # optional: pin a specific account
# DOCUSIGN_CONNECT_HMAC_KEY=  # Connect webhook HMAC key (docusign-connect)
# DOCUSIGN_COUNTERSIGNER_NAME=  # Fallback Delt countersigner identity —
# DOCUSIGN_COUNTERSIGNER_EMAIL= # org_esign_settings (Settings → E-Sign)
#                               # takes precedence; MCA sends FAIL without
#                               # one of the two being configured.
